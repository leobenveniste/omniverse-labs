rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para Círculo (Omniverse Labs)
    match /circulo_users/{userId} {
      allow read: if true;
      allow write: if true; // En producción: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'leobenveniste@vuelocontrolado.org');
    }
    match /circulo_swipes/{swipeId} {
      allow read, write: if true;
    }
    match /circulo_groups/{groupId} {
      allow read, write: if true;
    }
    match /circulo_messages/{messageId} {
      allow read, write: if true;
    }
    match /circulo_plans/{planId} {
      allow read, write: if true;
    }
    match /circulo_reports/{reportId} {
      allow read, write: if true;
    }
  }
}
