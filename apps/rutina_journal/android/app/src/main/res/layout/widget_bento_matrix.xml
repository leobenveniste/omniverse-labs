<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bento_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_card">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bento_circadian_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RITMO • MAÑANA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="#2D4A2B" />

            <TextView
                android:id="@+id/bento_status_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 de 5 hábitos cumplidos"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1B221C" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_item_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/bento_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="14 días"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#C85A3B" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Habit 1 Slot -->
    <LinearLayout
        android:id="@+id/habit_slot_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/habit_check_1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="○"
            android:textSize="16sp"
            android:textColor="#5A665D" />

        <TextView
            android:id="@+id/habit_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Agua e hidratación"
            android:textSize="12sp"
            android:textColor="#1B221C"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Habit 2 Slot -->
    <LinearLayout
        android:id="@+id/habit_slot_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/habit_check_2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="✓"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />

        <TextView
            android:id="@+id/habit_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Meditación & calma"
            android:textSize="12sp"
            android:textColor="#1B221C"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Habit 3 Slot -->
    <LinearLayout
        android:id="@+id/habit_slot_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/habit_check_3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="○"
            android:textSize="16sp"
            android:textColor="#5A665D" />

        <TextView
            android:id="@+id/habit_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Lectura profunda"
            android:textSize="12sp"
            android:textColor="#1B221C"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Pro Locked Overlay (hidden when isPro is true) -->
    <LinearLayout
        android:id="@+id/bento_pro_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#FAF8F5"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ RITMO PRO"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#C85A3B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Desbloquea la Matriz Bento interactiva con checks de 1 toque"
            android:textSize="11sp"
            android:textColor="#5A665D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_item_done_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Desbloquear Pro • \.99"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#2D4A2B" />
    </LinearLayout>

</LinearLayout>
