<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pulse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_bg_card">

    <!-- Top Row: Circadian Greeting & Flame Streak -->
    <LinearLayout
        android:id="@+id/pulse_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pulse_time_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ritmo • Hoy"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2D4A2B"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pulse_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#C85A3B" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center: Mindful Completion Percentage & Progress -->
    <LinearLayout
        android:id="@+id/pulse_center_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/pulse_percent_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="75%"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1B221C" />

        <TextView
            android:id="@+id/pulse_fraction_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="3 de 4 completados"
            android:textSize="12sp"
            android:textColor="#5A665D" />

        <!-- Slender Progress Bar -->
        <ProgressBar
            android:id="@+id/pulse_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="75"
            android:progressTint="#2D4A2B" />
    </LinearLayout>

    <!-- Bottom: Zen Intention / Focus Action Trigger -->
    <TextView
        android:id="@+id/pulse_zen_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:text="🌿 Un pequeño paso para tu paz"
        android:textSize="11sp"
        android:textColor="#8A968C"
        android:maxLines="1"
        android:ellipsize="end" />

</RelativeLayout>
